{
  "name": "shuttle-proxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && vite",
    "build": "node scripts/copy-vendor.mjs && vite build",
    "preview": "vite preview",
    "wisp": "node server/server.mjs",
    "deploy:surge": "npm run build && node -e \"require('node:fs').copyFileSync('dist/index.html','dist/200.html')\" && npx --yes surge dist movies-and-stuff.surge.sh"
  },
  "dependencies": {
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/scramjet": "2.1.0",
    "@mercuryworkshop/scramjet-controller": "0.1.0",
    "@mercuryworkshop/wisp-js": "0.5.3"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
